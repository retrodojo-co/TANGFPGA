{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/bl616/",
      "resources/nanoblast-v0.2.0/"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "TangFPGA",
        "languages": [
          "English"
        ],
        "compression": "lzma"
      }
    }
  }
}
